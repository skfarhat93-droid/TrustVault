# Development only. Change every value before using a production deployment.
TRUSTVAULT_ENV=development
TRUSTVAULT_SEED_DEMO_USERS=1
SECRET_KEY=replace-with-a-long-random-value
TRUSTVAULT_ADMIN_PASSWORD=replace-with-a-unique-local-password
TRUSTVAULT_OWNER_PASSWORD=replace-with-a-unique-local-password
TRUSTVAULT_VIEWER_PASSWORD=replace-with-a-unique-local-password
# Set to 1 only behind HTTPS in production.
TRUSTVAULT_COOKIE_SECURE=0
RATELIMIT_STORAGE_URI=memory://
